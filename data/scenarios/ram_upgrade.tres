[resource]
script = ExtResource("1_scenario")
title = "Sekme Açınca Donuyor (RAM Yükseltme)"
symptom_title = "Sekme Açınca Donuyor"
shop_stage = 1
price = 300
customer = "Deniz Bey"
complaint = ""
complaints = Array[String](["Birden fazla sekme açınca bilgisayar donuyor. Hafıza yetmiyor galiba, yükseltebilir misin?", "Tarayıcıda biraz sekme açınca her şey kasılıyor, ara sıra mavi ekran da veriyor. RAM'e bir bakar mısın?", "Sekme açınca bilgisayar donuyor, bazen kendiliğinden kapanıyor. Bellek yükseltmek lazım sanırım."])
menu_description = "Bellek yetersiz ve bir RAM çubuğu hatalı. Hangisinin sorunlu olduğunu BIOS'tan bul, sök ve bütçeye uygun yenisini tak."
hint = "İpucu: BIOS hangi RAM yuvasının arızalı olduğunu söyler. RAM'i sökmek için yuvanın iki ucundaki mandallara tıkla; RAM yerinden kalkınca basılı tutup envantere taşı. Sonra \"YENİ\" etiketli RAM'i boş yuvaya sürükle."
